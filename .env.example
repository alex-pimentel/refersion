APP_NAME="Refersion Leaderboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Refersion API credentials (never commit real values)
REFERSION_CLIENT_ID=
REFERSION_CLIENT_SECRET=
REFERSION_AUTH_URL=https://auth.refersion.com/oauth/token
REFERSION_BASE_URL=https://api.refersion.com/v2026-08
REFERSION_TOKEN_TYPE=short_lived
REFERSION_PAGE_LIMIT=100
REFERSION_CUSTOM_FIELDS_CHUNK=10
REFERSION_LEADERBOARD_SIZE=5
REFERSION_LEADERBOARD_CACHE_TTL=300
REFERSION_LEADERBOARD_LOCK_TTL=600
REFERSION_COMMISSION_UNIT=cents
REFERSION_MAX_PAGES=500
REFERSION_MAX_CANDIDATES=1000

VITE_APP_NAME="${APP_NAME}"
